                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="Juggle &#xe9; quando voc&#xea; acerta o oponente que j&#xe1; est&#xe1; no ar, depois de um primeiro golpe que o lan&#xe7;ou, e consegue encadear outro golpe antes de ele cair no ch&#xe3;o.&#xa;&#xa;Nos jogos de luta, um golpe que derruba ou lan&#xe7;a o advers&#xe1;rio o deixa em um estado em que ele n&#xe3;o pode se defender. Se o seu pr&#xf3;ximo ataque chega antes de ele aterrissar, ele leva o dano extra. Isso &#xe9; um juggle, e pode virar um combo."/>
                <Property name="wrapStyleWord" type="boolean" value="true"/>
              </Properties>
            </Component>
          </SubComponents>
        </Container>
